# Firebase (client SDK — web API key is restricted by HTTP referrer in GCP)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API
VITE_API_BASE_URL=http://localhost:8000

# App Check — leave empty in local dev unless configured
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# development | staging | production
VITE_APP_ENV=development

# Sentry (optional locally; required in staging/production)
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Legal pages (signup footer)
VITE_TERMS_URL=https://travely.app/terms
VITE_PRIVACY_URL=https://travely.app/privacy
